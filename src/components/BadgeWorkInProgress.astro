---
interface Props {
  lessonId: string;
  headings: { slug: string }[];
}
const { lessonId, headings } = Astro.props;
const badge = lessonId.startsWith('badge-2') ? 'Badge 2' : 'Badge 3';
---

<!-- Preserve incoming fragment links while withholding the draft lesson. -->
{headings.map(({ slug }) => <span id={slug} hidden />)}
<p>{badge} is being revised. The lessons will be available when the curriculum is ready.</p>
