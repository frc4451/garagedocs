---
import { withBase } from '@/lib/url';
---
<div class="offline-controls" role="group" aria-label="Offline access" data-offline-controls data-scope={withBase('/')} data-production={import.meta.env.PROD}>
  <p class="offline-status" data-offline-status role="status" aria-live="polite">Checking download…</p>
  <progress data-offline-progress hidden aria-label="Offline download progress"></progress>
  <div class="offline-actions">
    <button type="button" class="prefs-action" data-offline-download disabled>Download for Offline Use</button>
  </div>
</div>
<div class="offline-update-notice" data-offline-notice hidden role="status">
  <span>Update ready. Save your code before reloading.</span>
  <button type="button" data-offline-update>Update and reload</button>
  <button type="button" data-offline-dismiss aria-label="Dismiss update notice">×</button>
</div>
<script>
  import { initializeOffline } from '@/lib/offline';
  initializeOffline();
</script>
<style>
  .offline-controls { min-width: 0; }
  .offline-status { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .offline-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  .offline-update-notice button { font: inherit; color: var(--color-foreground-primary); background: var(--color-background-secondary); border: 1px solid var(--color-foreground-muted); border-radius: .4rem; padding: .65rem .8rem; min-height: 2.75rem; cursor: pointer; }
  progress { width: 100%; accent-color: var(--color-accent); margin: .5rem 0; }
  .offline-update-notice { position: fixed; bottom: 1rem; right: 1rem; max-width: calc(100vw - 2rem); z-index: 2000; padding: 1rem; background: var(--color-background-primary); color: var(--color-foreground-primary); border: 1px solid var(--color-foreground-muted); border-radius: .5rem; box-shadow: 0 .3rem 1.5rem #0003; display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
  [hidden] { display: none !important; }
  @media print { .offline-controls, .offline-update-notice { display: none; } }
</style>
