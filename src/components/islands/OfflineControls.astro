---
import { withBase } from '@/lib/url';
---
<section class="offline-controls" aria-labelledby="offline-title" data-offline-controls data-scope={withBase('/')} data-production={import.meta.env.PROD}>
  <h2 id="offline-title">Offline access</h2>
  <p>Read and search all docs without internet.</p>
  <p data-offline-status role="status" aria-live="polite">Checking download…</p>
  <progress data-offline-progress hidden aria-label="Offline download progress"></progress>
  <div class="offline-actions">
    <button type="button" data-offline-download disabled>Download for offline use</button>
    <button type="button" data-offline-update hidden>Update and reload</button>
    <button type="button" data-offline-install hidden>Install GarageDocs</button>
  </div>
  <p class="prefs-note">Running Java, watching videos, and opening external links require internet.</p>
  <p class="prefs-note" data-install-help>For an app shortcut, use your browser’s Install or Add to Home Screen option.</p>
</section>
<div class="offline-update-notice" data-offline-notice hidden role="status">
  <span>Update ready. Save your code before reloading.</span>
  <button type="button" data-offline-update>Update and reload</button>
  <button type="button" data-offline-dismiss aria-label="Dismiss update notice">×</button>
</div>
<script>
  import { initializeOffline } from '@/lib/offline';
  initializeOffline();
</script>
<style>
  .offline-controls { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--color-background-border); }
  .offline-controls h2 { font: 600 1.1rem var(--font-stack); margin: 0 0 .75rem; }
  .offline-controls p { margin: .75rem 0; }
  .offline-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  button { font: inherit; color: var(--color-foreground-primary); background: var(--color-background-secondary); border: 1px solid var(--color-foreground-muted); border-radius: .4rem; padding: .65rem .8rem; min-height: 2.75rem; cursor: pointer; }
  button:disabled { opacity: .6; cursor: default; }
  progress { width: 100%; accent-color: var(--color-accent); margin: .5rem 0; }
  .offline-update-notice { position: fixed; bottom: 1rem; right: 1rem; max-width: calc(100vw - 2rem); z-index: 2000; padding: 1rem; background: var(--color-background-primary); color: var(--color-foreground-primary); border: 1px solid var(--color-foreground-muted); border-radius: .5rem; box-shadow: 0 .3rem 1.5rem #0003; display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
  [hidden] { display: none !important; }
  @media print { .offline-controls, .offline-update-notice { display: none; } }
</style>
