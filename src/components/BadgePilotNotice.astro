---
import RulesBox from '@/components/blocks/RulesBox.astro';

interface Props {
  lessonId: string;
}
const { lessonId } = Astro.props;
const badge = (lessonId.match(/^badge-\d+/)?.[0] ?? 'badge-3').replace('badge-', 'Badge ');
---

<RulesBox>
  <p>
    <strong>{badge} is in its pilot.</strong> Physical commissioning, shot calibration and the
    student pilot are still open, so steps and Badge Check rows can change. Check with the mentor
    before starting a step.
  </p>
</RulesBox>
