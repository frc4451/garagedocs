---
import { renderMath } from '@/lib/math';

interface Props {
  tex: string;
  display?: boolean;
  /** Punctuation that follows an inline equation; set by remark-equation-punctuation. */
  trailing?: string;
}

const { tex, display = false, trailing } = Astro.props;
const mathml = renderMath(tex, display);
---

{display ? (
  <div class="math-display" tabindex="0" role="region" aria-label="Equation" set:html={mathml} />
) : (
  <span class="math-inline"><Fragment set:html={mathml} />{trailing}</span>
)}

<style>
  .math-inline {
    white-space: nowrap;
  }
</style>
