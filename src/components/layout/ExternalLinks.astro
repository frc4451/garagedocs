---
import { siteConfig } from '@/config/navigation';
---
<span hidden data-external-links-site={Astro.site?.href ?? siteConfig.url}></span>
<script>
  import { initializeExternalLinks } from '@/lib/external-links';
  const siteUrl = document.querySelector<HTMLElement>('[data-external-links-site]')?.dataset.externalLinksSite;
  if (siteUrl) initializeExternalLinks(siteUrl);
</script>
