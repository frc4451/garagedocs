---
import { siteConfig } from '@/config/navigation';
import { withBase } from '@/lib/url';

interface Props {
  width?: number;
  height?: number;
  class?: string;
}
---

<img
  src={withBase(siteConfig.brand.teamLogo)}
  alt=""
  class:list={['brand-icon', Astro.props.class]}
  width={Astro.props.width ?? 28}
  height={Astro.props.height ?? 28}
  decoding="async"
/>

<style>
  .brand-icon {
    flex-shrink: 0;
    display: block;
    object-fit: contain;
  }
</style>
