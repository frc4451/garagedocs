---
import { sections, appRoutes } from '@/config/navigation';
import { withBase } from '@/lib/url';
import BrandIcon from '@/components/layout/BrandIcon.astro';
import PreferencesButton from '@/components/islands/PreferencesButton.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(path: string): boolean {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<header class="mobile-header">
  <div class="header-toolbar">
    <div class="header-left">
      <button
        class="nav-overlay-icon"
        type="button"
        data-nav-toggle
        aria-controls="curriculum-sidebar"
        aria-expanded="false"
        aria-label="Open navigation"
      >
        <span class="icon" aria-hidden="true">☰</span>
      </button>
      <a class="header-brand" href={withBase('/')} aria-label="GarageDocs home">
        <BrandIcon class="header-brand-logo" width={44} height={32} />
        <span class="header-brand-text">GarageDocs</span>
      </a>
    </div>
    <div class="header-center">
      <nav class="header-navigation">
        <a href={withBase('/')} class:list={['header-nav-link', { active: isActive('/') }]}>Home</a>
        {sections.map((section) => (
          <a
            href={withBase(section.path)}
            class:list={['header-nav-link', { active: isActive(section.path) }]}
          >
            {section.label}
          </a>
        ))}
        {appRoutes.map((route) => (
          <a
            href={withBase(route.path)}
            class:list={['header-nav-link', { active: isActive(route.path) }]}
          >
            {route.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="header-right">
      <div class="theme-toggle-container prefs-header">
        <PreferencesButton />
      </div>
    </div>
  </div>
</header>
