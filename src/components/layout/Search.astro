---
import { withBase } from '@/lib/url';
---

<link href={withBase('/pagefind/pagefind-ui.css')} rel="stylesheet" />
<script src={withBase('/pagefind/pagefind-ui.js')} is:inline></script>

<div id="garagedocs-search-overlay" class="search-results-overlay" data-search-overlay aria-hidden="true" hidden>
  <div class="search-results-modal" data-search-modal role="dialog" aria-modal="true" aria-label="Search GarageDocs">
    <div class="search-results-head">
      <span>Search GarageDocs</span>
      <button type="button" class="search-results-close" data-search-close aria-label="Close search">×</button>
    </div>
    <div id="pagefind-search"></div>
    <p id="search-unavailable" class="search-unavailable-message" hidden>
      Search needs an index, which <code>npm run build</code> creates. Run it once; the dev server then serves the index without a restart.
    </p>
  </div>
</div>

<script>
  import { withBase } from '@/lib/url';

  interface PagefindResult {
    url?: string;
    sub_results?: { url?: string }[];
  }

  let lastSearchTrigger: HTMLElement | null = null;
  let suppressTriggerOpen = false;

  /**
   * Pagefind indexes dist/, so its result URLs are site-root-relative and miss
   * the base path the site is deployed under (e.g. GitHub Pages).
   */
  function addBaseToResultUrls(result: PagefindResult): PagefindResult {
    if (result?.url) result.url = withBase(result.url);
    for (const sub of result?.sub_results ?? []) {
      if (sub?.url) sub.url = withBase(sub.url);
    }
    return result;
  }

  function setSearchOverlayOpen(open: boolean) {
    const overlay = document.querySelector('[data-search-overlay]') as HTMLElement | null;
    if (!overlay) return;
    overlay.classList.toggle('visible', open);
    overlay.toggleAttribute('hidden', !open);
    overlay.setAttribute('aria-hidden', open ? 'false' : 'true');
    if ('inert' in overlay) {
      (overlay as HTMLElement & { inert: boolean }).inert = false;
    }
  }

  function closeSearchOverlay(refocus = true) {
    setSearchOverlayOpen(false);
    if (refocus && lastSearchTrigger) {
      suppressTriggerOpen = true;
      lastSearchTrigger.focus({ preventScroll: true });
      queueMicrotask(() => { suppressTriggerOpen = false; });
    }
  }

  function openSearchOverlay(query = '') {
    setSearchOverlayOpen(true);

    const container = document.getElementById('pagefind-search');
    const pfInput = container?.querySelector('input');
    if (pfInput instanceof HTMLInputElement) {
      pfInput.value = query;
      pfInput.focus();
      pfInput.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }

  function showUnavailable() {
    const msg = document.getElementById('search-unavailable');
    const container = document.getElementById('pagefind-search');
    if (msg) msg.hidden = false;
    if (container) container.style.display = 'none';
  }

  function wireSearchInputs() {
    document.querySelectorAll('[data-pagefind-search]').forEach((input) => {
      if (input.getAttribute('data-search-wired')) return;
      input.setAttribute('data-search-wired', 'true');

      const sync = () => {
        if (suppressTriggerOpen) return;
        if (input instanceof HTMLInputElement) {
          lastSearchTrigger = input;
          openSearchOverlay(input.value);
        }
      };

      input.addEventListener('focus', sync);
      input.addEventListener('input', sync);
      // Enter with results open follows the first result, so a query typed in the
      // sidebar can be completed from the keyboard without reaching for the mouse.
      input.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key !== 'Enter') return;
        const first = document.querySelector<HTMLAnchorElement>('#pagefind-search .pagefind-ui__result-link');
        if (first?.href) {
          e.preventDefault();
          window.location.href = first.href;
        }
      });
    });
  }

  function wireSearchButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-search-toggle]').forEach((button) => {
      if (button.dataset.searchWired) return;
      button.dataset.searchWired = 'true';
      button.addEventListener('click', () => {
        lastSearchTrigger = button;
        openSearchOverlay();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-search-close]').forEach((button) => {
      if (button.dataset.searchWired) return;
      button.dataset.searchWired = 'true';
      button.addEventListener('click', () => closeSearchOverlay());
    });
  }

  function initPagefind() {
    // @ts-expect-error pagefind UI loaded via script tag
    if (typeof PagefindUI === 'undefined') {
      // No index (fresh clone, or dev before the first build). Still wire the header
      // input so focusing it opens the overlay and shows the message instead of
      // doing nothing at all.
      showUnavailable();
      wireSearchInputs();
      wireSearchButtons();
      // @ts-expect-error expose for keyboard shortcuts
      window.garagedocsOpenSearch = openSearchOverlay;
      return;
    }

    const container = document.getElementById('pagefind-search');
    if (!container || container.getAttribute('data-initialized')) {
      wireSearchInputs();
      wireSearchButtons();
      return;
    }
    container.setAttribute('data-initialized', 'true');

    try {
      // @ts-expect-error global from pagefind-ui.js
      new PagefindUI({
        element: '#pagefind-search',
        showSubResults: true,
        resetStyles: false,
        processResult: addBaseToResultUrls,
      });
    } catch {
      showUnavailable();
      return;
    }

    wireSearchInputs();
    wireSearchButtons();

    // @ts-expect-error expose for keyboard shortcuts
    window.garagedocsOpenSearch = openSearchOverlay;

    const overlay = document.querySelector('[data-search-overlay]');
    if (overlay && !overlay.getAttribute('data-overlay-init')) {
      overlay.setAttribute('data-overlay-init', 'true');
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeSearchOverlay(false);
      });
    }

    const modal = document.querySelector('[data-search-modal]');
    if (modal && !modal.getAttribute('data-modal-init')) {
      modal.setAttribute('data-modal-init', 'true');
      modal.addEventListener('click', (e) => e.stopPropagation());
    }

    if (!document.body.getAttribute('data-search-key-init')) {
      document.body.setAttribute('data-search-key-init', 'true');
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !document.querySelector<HTMLElement>('[data-search-overlay]')?.hidden) {
          e.preventDefault();
          e.stopImmediatePropagation();
          closeSearchOverlay();
        }
      }, { capture: true });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    initPagefind();
    setSearchOverlayOpen(false);
  });
  document.addEventListener('astro:page-load', () => {
    initPagefind();
    setSearchOverlayOpen(false);
  });
</script>
