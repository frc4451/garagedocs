---
import BrandIcon from '@/components/layout/BrandIcon.astro';
import type { SidebarGroup } from '@/lib/content';
import { withBase } from '@/lib/url';
import { sections, appRoutes } from '@/config/navigation';

interface Props {
  currentPath: string;
  sidebarGroups: SidebarGroup[];
  showSidebar: boolean;
}

const { currentPath, sidebarGroups, showSidebar } = Astro.props;

function isLessonActive(href: string): boolean {
  return currentPath === href || currentPath === `${href}/`;
}

function groupHasActiveLesson(group: SidebarGroup): boolean {
  return group.items.some((item) => isLessonActive(item.href));
}

function isRouteActive(path: string): boolean {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}

const currentSection = sections.find((section) => isRouteActive(section.path));
---

<aside
  class="sidebar-drawer"
  id="curriculum-sidebar"
  aria-label="Site and curriculum navigation"
  aria-hidden="true"
  data-has-curriculum={showSidebar && sidebarGroups.length > 0 ? 'true' : 'false'}
>
  <div class="sidebar-container">
    <div class="sidebar-sticky">
      <div class="sidebar-panel-head">
        <a class="sidebar-brand" href={withBase('/')}>
          <BrandIcon class="sidebar-brand-logo" width={52} height={38} />
          <span class="sidebar-brand-text">GarageDocs</span>
        </a>
        <button class="sidebar-close" type="button" data-nav-close aria-label="Close navigation">×</button>
      </div>

      <div class="sidebar-search">
        <label class="visually-hidden" for="sidebar-search">Search GarageDocs</label>
        <span class="sidebar-search-icon" aria-hidden="true">⌕</span>
        <input
          type="search"
          id="sidebar-search"
          class="sidebar-search-input"
          placeholder="Search (Ctrl+K)"
          autocomplete="off"
          autocorrect="off"
          aria-haspopup="dialog"
          data-pagefind-search
        />
      </div>

      <div class="sidebar-scroll">
        <nav class="sidebar-site-nav" aria-label="Site sections">
          <p class="sidebar-site-nav-label">Explore GarageDocs</p>
          <ul>
            <li><a href={withBase('/')} class:list={{ active: isRouteActive('/') }}>Home</a></li>
            {sections.map((section) => (
              <li>
                <a href={withBase(section.path)} class:list={{ active: isRouteActive(section.path) }}>
                  {section.label}
                </a>
              </li>
            ))}
            {appRoutes.map((route) => (
              <li>
                <a href={withBase(route.path)} class:list={{ active: isRouteActive(route.path) }}>
                  {route.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        {showSidebar && sidebarGroups.length > 0 && (
          <div class="sidebar-tree">
            <p class="caption" role="heading">
              <span class="caption-text">{currentSection?.label ?? 'Course'} curriculum</span>
            </p>
            <ul id="sidebar-navigation">
              {sidebarGroups.map((group) => {
                const isExpanded = groupHasActiveLesson(group);
                return (
                  <li class="parent-tab sidebar-group" data-group-id={group.id}>
                    <button
                      type="button"
                      class="parent-reference sidebar-group-toggle"
                      data-group-toggle={group.id}
                      aria-expanded={isExpanded}
                    >
                      <span class:list={['expand-icon', `expand-icon-${group.id}`]}>
                        {isExpanded ? '▼' : '▶'}
                      </span>
                      {group.label}
                    </button>
                    <ul
                      class:list={['children-nav', { expanded: isExpanded, collapsed: !isExpanded }]}
                      id={`children-${group.id}`}
                    >
                      {group.items.map((item) => (
                        <li class="child-tab">
                          <a
                            href={withBase(item.href)}
                            class:list={['child-reference sidebar-link', { active: isLessonActive(item.href) }]}
                          >
                            {item.label}
                            {item.duration && <span class="sidebar-meta">{item.duration}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
  <div class="sidebar-resize-handle" data-sidebar-resize></div>
</aside>

<script>
  function initSidebarGroups() {
    document.querySelectorAll('[data-group-toggle]').forEach((btn) => {
      if (btn.getAttribute('data-initialized')) return;
      btn.setAttribute('data-initialized', 'true');

      btn.addEventListener('click', () => {
        const groupId = btn.getAttribute('data-group-toggle');
        if (!groupId) return;

        const childrenNav = document.getElementById(`children-${groupId}`);
        const expandIcon = document.querySelector(`.expand-icon-${groupId}`);
        if (!childrenNav || !expandIcon) return;

        const isExpanded = childrenNav.classList.contains('expanded');
        if (isExpanded) {
          childrenNav.classList.remove('expanded');
          childrenNav.classList.add('collapsed');
          expandIcon.textContent = '▶';
          btn.setAttribute('aria-expanded', 'false');
        } else {
          childrenNav.classList.add('expanded');
          childrenNav.classList.remove('collapsed');
          expandIcon.textContent = '▼';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  function applySidebarWidth(drawer: HTMLElement, width: number) {
    const px = `${width}px`;
    drawer.style.width = px;
    document.documentElement.style.setProperty('--sidebar-width', px);
    localStorage.setItem('garagedocs-sidebar-width', px);
  }

  function initSidebarResize() {
    const handle = document.querySelector('[data-sidebar-resize]');
    const drawer = document.querySelector('.sidebar-drawer') as HTMLElement | null;
    if (!handle || !drawer) return;

    const saved = localStorage.getItem('garagedocs-sidebar-width') ?? localStorage.getItem('mantik-sidebar-width');
    if (saved) {
      drawer.style.width = saved;
      document.documentElement.style.setProperty('--sidebar-width', saved);
    }

    let resizing = false;
    handle.addEventListener('mousedown', () => {
      resizing = true;
      document.documentElement.classList.add('sidebar-resizing');
    });
    document.addEventListener('mouseup', () => {
      resizing = false;
      document.documentElement.classList.remove('sidebar-resizing');
    });
    document.addEventListener('mousemove', (e) => {
      if (!resizing) return;
      const width = Math.min(Math.max(e.clientX, 200), 500);
      applySidebarWidth(drawer, width);
    });
  }

  initSidebarGroups();
  initSidebarResize();
  document.addEventListener('astro:page-load', () => {
    initSidebarGroups();
    initSidebarResize();
  });
</script>
