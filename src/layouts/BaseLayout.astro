---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import HeaderBehavior from '@/components/layout/HeaderBehavior.astro';
import Sidebar from '@/components/layout/Sidebar.astro';
import SidebarBehavior from '@/components/layout/SidebarBehavior.astro';
import KeyboardShortcuts from '@/components/layout/KeyboardShortcuts.astro';
import PreferencesDrawer from '@/components/islands/PreferencesDrawer.astro';
import Search from '@/components/layout/Search.astro';
import { siteConfig } from '@/config/navigation';
import { withBase } from '@/lib/url';
import { CHEERPJ_LOADER, ECJ_FILENAME } from '@/lib/java-playground/constants';
import { LAUNCHER_FILENAME, playgroundPublicUrl } from '@/lib/java-playground/assets';
import type { SidebarGroup } from '@/lib/content';

interface Props {
  title: string;
  description?: string;
  currentPath: string;
  sidebarGroups?: SidebarGroup[];
  showSidebar?: boolean;
  canonical?: string;
  /** Java lessons hydrate runnable examples; warm the runtime fetches early. */
  javaExamples?: boolean;
}

const {
  title,
  description = siteConfig.description,
  currentPath,
  sidebarGroups = [],
  showSidebar = false,
  canonical,
  javaExamples = false,
} = Astro.props;

const fullTitle = title === siteConfig.title ? title : `${title} | GarageDocs`;
const canonicalUrl = canonical ?? new URL(withBase(currentPath), siteConfig.url).href;
const ogImageUrl = new URL(withBase(siteConfig.brand.ogImage), siteConfig.url).href;
const ecjHref = playgroundPublicUrl(ECJ_FILENAME);
const launcherHref = playgroundPublicUrl(LAUNCHER_FILENAME);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf9" />
    <meta name="google-site-verification" content="ETN7XF-En_qRybmYUpnQmd8Emp5qYo2nkpsYSaBfWxs" />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="GarageDocs" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Source+Sans+3:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <link rel="icon" href={withBase(siteConfig.brand.iconLight)} type="image/svg+xml" />

    {javaExamples && <link rel="preconnect" href="https://cjrtnc.leaningtech.com" />}
    {
      javaExamples && (
        <script>
          import { installJavaPageStartup } from '@/lib/java-playground/pageStartup';
          installJavaPageStartup();
        </script>
      )
    }
    {javaExamples && <link rel="preload" as="script" href={CHEERPJ_LOADER} crossorigin="anonymous" />}
    {javaExamples && <link rel="preload" as="fetch" href={ecjHref} crossorigin="anonymous" />}
    {javaExamples && <link rel="preload" as="fetch" href={launcherHref} crossorigin="anonymous" />}

    <script is:inline>
      /* Reader preferences, applied before first paint so nothing flashes.
         Mirrors src/lib/prefs.ts (which cannot be imported inline). */
      (function () {
        var h = document.documentElement, p = {};
        try {
          var raw = localStorage.getItem('garagedocs-prefs') || localStorage.getItem('mantik-prefs');
          if (raw) p = JSON.parse(raw) || {};
          else { var t = localStorage.getItem('mantik-theme'); if (t === 'light' || t === 'dark') p.theme = t; }
        } catch (e) {}
        var ok = function (v, list, d) { return list.indexOf(v) >= 0 ? v : d; };
        var theme = ok(p.theme, ['system', 'light', 'dark'], 'system');
        if (theme === 'system') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        h.setAttribute('data-theme', theme);
        h.style.colorScheme = theme;
        h.setAttribute('data-text', ok(p.text, ['sm', 'md', 'lg', 'xl'], 'md'));
        h.setAttribute('data-spacing', ok(p.spacing, ['normal', 'relaxed'], 'normal'));
        h.setAttribute('data-contrast', ok(p.contrast, ['normal', 'high'], 'normal'));
        h.setAttribute('data-motion', ok(p.motion, ['system', 'reduce'], 'system'));
      })();
    </script>
  </head>
  <body class:list={[{ 'has-curriculum-sidebar': showSidebar && sidebarGroups.length > 0 }]}>
    <input
      type="checkbox"
      class="sidebar-toggle"
      name="__navigation"
      id="__navigation"
      checked={showSidebar && sidebarGroups.length > 0}
    />
    <button
      class="overlay sidebar-overlay"
      type="button"
      data-nav-overlay
      aria-label="Close navigation"
    ></button>

    <KeyboardShortcuts />
    <Search />
    <PreferencesDrawer />
    {
      javaExamples && (
        <div class="jp-runtime-toast" data-jp-runtime-status role="status" aria-live="polite" hidden>
          <span class="jp-runtime-toast-spinner" aria-hidden="true"></span>
          <span class="jp-runtime-toast-text"></span>
        </div>
      )
    }
    <HeaderBehavior />
    <SidebarBehavior />

    <div class="page">
      <Header currentPath={currentPath} />
      <Sidebar currentPath={currentPath} sidebarGroups={sidebarGroups} showSidebar={showSidebar} />

      <main class="main">
        <div class="content">
          <div class="article-container">
            <article role="main" id="furo-main-content">
              <slot />
            </article>
          </div>
          <footer>
            <div class="bottom-of-page">
              <div class="left-details">
                <div class="copyright">Copyright © 2026 FRC 4451 ROBOTZ Garage</div>
              </div>
              <div class="right-details">
                <a href={siteConfig.github} target="_blank" rel="noopener noreferrer">
                  GitHub
                </a>
              </div>
            </div>
          </footer>
        </div>
      </main>
    </div>
  </body>
</html>
