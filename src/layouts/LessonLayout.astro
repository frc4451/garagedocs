---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/layout/Breadcrumb.astro';
import type { SidebarGroup } from '@/lib/content';
import type { SidebarItem } from '@/lib/content';
import { withBase } from '@/lib/url';
import JavaExampleHydrate from '@/components/java-playground/JavaExampleHydrate.astro';
import DevEditLink from '@/components/layout/DevEditLink.astro';

interface Props {
  title: string;
  description?: string;
  currentPath: string;
  sidebarGroups: SidebarGroup[];
  prev?: SidebarItem;
  next?: SidebarItem;
  difficulty?: string;
  duration?: string;
  unlisted?: boolean;
  javaExamples?: boolean;
  sourcePath?: string;
}

const {
  title,
  description,
  currentPath,
  sidebarGroups,
  prev,
  next,
  difficulty,
  duration,
  unlisted,
  javaExamples = false,
  sourcePath,
} = Astro.props;

// The group this page sits in, for the breadcrumb. Matched by href so Java's part prefixes work too.
const normalized = currentPath.replace(/\/$/, '');
const currentGroup = sidebarGroups.find((group) =>
  group.items.some((item) => item.href.replace(/\/$/, '') === normalized),
);
---

<BaseLayout
  title={title}
  description={description}
  currentPath={currentPath}
  sidebarGroups={sidebarGroups}
  showSidebar={true}
  javaExamples={javaExamples}
>
  <Breadcrumb currentPath={currentPath} title={title} groupLabel={currentGroup?.label} />

  <div class="lesson-header">
    <h1>{title}</h1>
    {(difficulty || duration) && (
      <div class="lesson-meta">
        {difficulty && <span class="lesson-difficulty">{difficulty}</span>}
        {duration && <span class="lesson-duration">{duration}</span>}
      </div>
    )}
  </div>
  <DevEditLink sourcePath={sourcePath} />

  {/* Pagefind ignores pages with no data-pagefind-body, which keeps unlisted lessons out of search. */}
  <div class="lesson-content" data-pagefind-body={unlisted ? undefined : true}>
    <slot />
  </div>
  {javaExamples && <JavaExampleHydrate />}

  {(prev || next) && (
    <nav class="lesson-nav" aria-label="Lesson navigation">
      {prev ? (
        <a href={withBase(prev.href)} class="lesson-nav-link lesson-nav-prev">
          <span class="lesson-nav-label">Previous</span>
          <span class="lesson-nav-title">{prev.label}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a href={withBase(next.href)} class="lesson-nav-link lesson-nav-next">
          <span class="lesson-nav-label">Next</span>
          <span class="lesson-nav-title">{next.label}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )}
</BaseLayout>

<script>
  function navigateLesson(direction: 'prev' | 'next') {
    const selector = direction === 'prev' ? '.lesson-nav-prev' : '.lesson-nav-next';
    const link = document.querySelector<HTMLAnchorElement>(selector);
    if (link) window.location.href = link.href;
  }

  function initLessonNav() {
    if (document.body.getAttribute('data-lesson-nav-init')) return;
    document.body.setAttribute('data-lesson-nav-init', 'true');

    document.addEventListener('keydown', (e) => {
      if (!e.ctrlKey && !e.metaKey) return;
      const target = e.target as HTMLElement;
      if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA') return;

      if (e.key === 'ArrowLeft' || e.key === '<') {
        e.preventDefault();
        navigateLesson('prev');
      }
      if (e.key === 'ArrowRight' || e.key === '>') {
        e.preventDefault();
        navigateLesson('next');
      }
    });
  }

  initLessonNav();
  document.addEventListener('astro:page-load', initLessonNav);
</script>
