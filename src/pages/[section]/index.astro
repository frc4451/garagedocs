---
import LessonLayout from '@/layouts/LessonLayout.astro';
import PublicBadgesOverview from '@/components/PublicBadgesOverview.astro';
import { isBadgeWorkInProgress } from '@/lib/badge-publication';
import { getOverview, getSidebarGroups, getJavaSidebarGroups } from '@/lib/content';
import { sections } from '@/config/navigation';
import { render } from 'astro:content';
import { components } from '@/mdx-components';
import type { SectionId } from '@/config/navigation';

export async function getStaticPaths() {
  return sections.map((section) => ({
    params: { section: section.id },
  }));
}

const { section } = Astro.params as { section: SectionId };

const overview = await getOverview(section);
if (!overview) throw new Error(`Overview not found for section: ${section}`);

const sidebarGroups = section === 'java' ? await getJavaSidebarGroups() : await getSidebarGroups(section);
const { Content, headings } = await render(overview);
const publicBadgesOverview = section === 'badges' &&
  sidebarGroups.some((group) => isBadgeWorkInProgress(section, group.id));
const currentPath = `/${section}`;
---

<LessonLayout
  title={overview.data.title}
  description={overview.data.description}
  currentPath={currentPath}
  sidebarGroups={sidebarGroups}
  javaExamples={section === 'java' || section === 'assignments'}
  sourcePath={overview.filePath}
>
  <>{publicBadgesOverview ? <PublicBadgesOverview groups={sidebarGroups} headings={headings} /> : <Content components={components} />}</>
</LessonLayout>
