---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/url';
---

<BaseLayout title="Page Not Found" currentPath="/404" showSidebar={false}>
  <div class="lesson-content">
    <h1>404 — Page Not Found</h1>
    <p>The page you are looking for does not exist or has been moved.</p>
    <p>
      <a href={withBase('/')}>Return to homepage</a>, or start with
      <a href={withBase('/tools')}>Tools</a>, <a href={withBase('/java')}>Java</a>,
      <a href={withBase('/assignments')}>Practice</a>, <a href={withBase('/kit-bot')}>Kit Bot</a>,
      or <a href={withBase('/frc')}>FRC</a>.
    </p>
  </div>
</BaseLayout>
