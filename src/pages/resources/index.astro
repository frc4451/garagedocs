---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResourcesApp from '@/components/resources/ResourcesApp';
import { getResources, getMinorTags } from '@/lib/resources/getResources';
import '@/styles/resources.css';

const resources = getResources();
const minorTags = getMinorTags(resources);
---

<BaseLayout
  title="Programming Resources"
  description="Search current documentation, tools, source repositories, and retained community references used by GarageDocs."
  currentPath="/resources"
  showSidebar={false}
>
  <div class="resources-page">
    <h1>Programming Resources</h1>
    <p class="resources-intro" data-pagefind-body>
      Browse the documentation, tools, source repositories, and community references used by GarageDocs.
      Current official resources appear first. Earlier links remain available for older projects and added context.
      This catalog was reviewed in September 2026.
    </p>
    <ResourcesApp client:load resources={resources} minorTags={minorTags} />
  </div>
</BaseLayout>
