---
import LessonLayout from '@/layouts/LessonLayout.astro';
import { getLesson, getJavaSidebarGroups } from '@/lib/content';
import { render } from 'astro:content';
import { components } from '@/mdx-components';

const overview = await getLesson('java', 'fundamentals-overview');
if (!overview) throw new Error('Java Fundamentals overview not found');

const sidebarGroups = await getJavaSidebarGroups();
const { Content } = await render(overview);
---

<LessonLayout
  title={overview.data.title}
  description={overview.data.description}
  currentPath="/java/fundamentals"
  sidebarGroups={sidebarGroups}
  javaExamples={true}
>
  <Content components={components} />
</LessonLayout>
