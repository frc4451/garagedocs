---
import { getSectionLessons } from '@/lib/content';
import { withBase } from '@/lib/url';

export async function getStaticPaths() {
  const lessons = await getSectionLessons('assignments');
  return lessons
    .filter((lesson) => !lesson.data.isOverview && !lesson.data.unlisted)
    .map((lesson) => ({ params: { lessonId: lesson.data.lessonId } }));
}

const { lessonId } = Astro.params;
const destination = withBase(`/java/assignments/${lessonId}`);
void destination; // Astro's checker does not count references in a top-level redirect return.
return Astro.redirect(destination, 301);
---
