---
import { getSectionLessons } from '@/lib/content';
import { withBase } from '@/lib/url';

export async function getStaticPaths() {
  const lessons = await getSectionLessons('assignments');
  return lessons
    .filter((lesson) => !lesson.data.isOverview && !lesson.data.unlisted)
    .map((lesson) => ({ params: { lessonId: lesson.data.lessonId } }));
}

const { lessonId } = Astro.params;
return Astro.redirect(withBase(`/java/assignments/${lessonId}`), 301);
---
