{
  "name": "mantik",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/fetch-java-playground-assets.mjs && node scripts/build-java-launcher.mjs",
    "prestart": "node scripts/fetch-java-playground-assets.mjs && node scripts/build-java-launcher.mjs",
    "prebuild": "node scripts/fetch-java-playground-assets.mjs && node scripts/build-java-launcher.mjs",
    "dev": "astro dev",
    "dev:search": "npm run build && astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:analyze": "node scripts/build-analyze.mjs",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "links": "node scripts/check-links.mjs dist",
    "sources": "node scripts/check-sources.mjs",
    "check": "astro check",
    "test": "vitest run",
    "verify:assignments": "vite-node scripts/verify-assignment-checks.mjs",
    "durations": "node scripts/estimate-durations.mjs",
    "durations:write": "node scripts/estimate-durations.mjs --write",
    "sessions:write": "vite-node scripts/add-session-plans.mjs --write",
    "migrate": "node scripts/migrate-json-to-mdx.mjs",
    "seed:resources": "node scripts/seed-resources-from-mdx.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.4.1",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "astro": "^7.0.0",
    "pagefind": "^1.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.67"
  },
  "overrides": {
    "dompurify": "^3.4.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.8.3",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
